PORT=3000
CRM_MODE=mock
DEMO_API_TOKEN=replace-with-a-random-local-token
INTERACTION_TTL_MINUTES=30

# Dynamics 365 / Dataverse mode (required only when CRM_MODE=dynamics)
DYNAMICS_BASE_URL=https://your-org.crm.dynamics.com
DYNAMICS_TENANT_ID=00000000-0000-0000-0000-000000000000
DYNAMICS_CLIENT_ID=00000000-0000-0000-0000-000000000000
DYNAMICS_CLIENT_SECRET=replace-with-client-secret

# Optional mapping files
CRM_FIELD_MAPPING_FILE=./config/field-mappings.json
GENERATION_LABELS_FILE=./config/generation-labels.json
